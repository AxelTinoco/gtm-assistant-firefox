{
  "root": true,
  "env": {
    "browser": true,
    "webextensions": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "extends": ["eslint:recommended", "prettier"],
  "globals": {
    "browser": "readonly",
    "chrome": "readonly"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": "off",
    "eqeqeq": ["error", "always"],
    "prefer-const": "warn"
  },
  "ignorePatterns": [
    "node_modules/",
    "web-ext-artifacts/",
    "dist/",
    "build/"
  ]
}
